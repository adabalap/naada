+  const btn = e.target.closest(".t-menu[data-menu]");
+  if (!btn) return;
+  e.stopPropagation();
+  e.preventDefault();
+  const row = btn.closest(".track, .pl-row");
+  const ctx = row ? tmContextOf(row) : "browse";
