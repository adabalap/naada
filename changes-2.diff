+    radial-gradient(circle at 88% 16%, rgba(34,211,238,.14)  0%, transparent 42%),
+    radial-gradient(circle at 50% 96%, rgba(245,158,11,.12)  0%, transparent 50%),
+    radial-gradient(circle at 80% 70%, rgba(123,63,160,.20)  0%, transparent 48%),
+    #120C1A;
+}
+html[data-theme="dark"] body::before { opacity: .5; filter: invert(1) brightness(1.6); }
+html[data-theme="dark"] .lyrics-art,
+html[data-theme="dark"] .np-vinyl-ph,
+html[data-theme="dark"] .now-vinyl .np-vinyl-ph { box-shadow: 0 14px 44px rgba(0,0,0,.55); }
+html[data-theme="dark"] .search-box,
+html[data-theme="dark"] .modal-input { background: var(--gray-50); }
+html[data-theme="dark"] .about-logo img { box-shadow: 0 8px 28px rgba(0,0,0,.5); }
+html[data-theme="dark"] .lib-hero { filter: saturate(1.05); }
+
+/* ═══════════════════════════════════════════════════════════════
+   v3.1 — theme control, track context menu, pins, bulk select
+═══════════════════════════════════════════════════════════════ */
+
+/* Segmented theme control in Settings */
+.seg-ctrl {
+  display: inline-flex; gap: 2px; padding: 3px;
+  background: var(--gray-100); border-radius: 12px;
+}
+.seg-opt {
+  display: inline-flex; align-items: center; gap: 4px;
+  border: none; background: none; cursor: pointer;
+  padding: 7px 11px; border-radius: 9px;
+  font-size: 12px; font-weight: 600; color: var(--gray-600);
+  transition: background .15s, color .15s;
+}
+.seg-opt i { font-size: 14px; }
+.seg-opt.active {
+  background: var(--white); color: var(--purple);
+  box-shadow: var(--shadow-sm);
+}
+
+/* Track context menu head */
+.tm-head {
+  display: flex; align-items: center; gap: 12px;
+  padding: 4px 4px 14px; border-bottom: 1px solid var(--gray-100);
+  margin-bottom: 12px;
+}
+.tm-art {
+  width: 48px; height: 48px; border-radius: 10px; flex-shrink: 0;
+  background: var(--grad-brand); overflow: hidden;
+  display: flex; align-items: center; justify-content: center;
+  font-size: 20px; color: #fff;
+}
+.tm-art img { width: 100%; height: 100%; object-fit: cover; }
+.tm-info { min-width: 0; }
+.tm-title {
+  font-size: 15px; font-weight: 700; color: var(--black);
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+}
+.tm-artist {
+  font-size: 12px; color: var(--gray-400); margin-top: 2px;
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+}
+.modal-opt { display: flex; align-items: center; gap: 11px; }
+.modal-opt i { font-size: 19px; color: var(--gray-600); flex-shrink: 0; }
+.modal-opt.danger i { color: var(--rose); }
+
+/* Row press feedback while long-pressing */
+.track.pressing { background: var(--purple-bg); transition: background .3s; }
+
+/* Pinned song badge on cards; pinned playlist marker */
+.pin-badge {
+  position: absolute; top: 6px; right: 6px; z-index: 2;
+  width: 22px; height: 22px; border-radius: 50%;
+  background: var(--gold); color: #fff;
+  display: flex; align-items: center; justify-content: center;
+  font-size: 12px; box-shadow: var(--shadow-sm);
+}
+.pl-card { position: relative; }
+.pl-card .pin-badge { top: 18px; right: 18px; }
+.pl-card-menu {
+  position: absolute; top: 14px; left: 14px; z-index: 2;
+  width: 26px; height: 26px; border-radius: 50%; border: none;
+  background: rgba(0,0,0,.35); color: #fff; cursor: pointer;
+  display: flex; align-items: center; justify-content: center; font-size: 15px;
+  backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
+}
+
+/* Bulk-select bar (playlist detail edit mode) */
+.bulk-bar {
+  position: fixed; left: 50%; transform: translateX(-50%) translateY(120%);
+  bottom: 14px; width: calc(100% - 24px); max-width: 456px;
+  background: var(--surface-glass-strong);
+  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
+  border: 1px solid var(--gray-100);
+  border-radius: 16px; box-shadow: var(--shadow-lg);
+  display: flex; align-items: center; justify-content: space-between; gap: 8px;
+  padding: 10px 14px; z-index: 700;
+  transition: transform .28s var(--ease-soft);
+}
+.bulk-bar.show { transform: translateX(-50%) translateY(0); }
+.bulk-count { font-size: 12px; font-weight: 700; color: var(--purple); flex-shrink: 0; }
+.bulk-actions { display: flex; gap: 6px; }
+.bulk-btn {
+  display: inline-flex; align-items: center; gap: 4px;
+  border: none; border-radius: 18px; padding: 8px 11px;
+  background: var(--gray-100); color: var(--gray-800);
+  font-size: 11.5px; font-weight: 600; cursor: pointer;
+}
+.bulk-btn.danger { background: var(--rose-bg); color: var(--rose); }
+
+/* Selection checkboxes in playlist edit mode */
+.sel-box {
+  width: 22px; height: 22px; border-radius: 7px; flex-shrink: 0;
+  border: 2px solid var(--gray-200); background: var(--white);
+  display: flex; align-items: center; justify-content: center;
+  color: transparent; font-size: 14px; transition: all .12s;
+}
+.track.selected .sel-box {
+  background: var(--purple-fill); border-color: var(--purple-fill); color: #fff;
+}
+.track.selected { background: var(--purple-bg); }
+
+/* The target-playlist picker must stack above the playlist-detail sheet
+   (both are .sheet at z-index 500) or bulk Copy/Move taps get swallowed
+   by the sheet underneath. */
+#add-pl-sheet { z-index: 560; }
+/* Same story for the create-playlist modal reached from that picker */
+#create-pl-modal { z-index: 620; }
+
+/* ═══════════════════════════════════════════════════════════════
+   v24 — dynamic album color, mini-player swipe, playlist reorder
+═══════════════════════════════════════════════════════════════ */
+
+/* ── Dynamic color: the now-playing screen takes its wash from the
+   album art. Two custom props are set from JS; everything below reads
+   from them, so a single failed extraction just falls back to --now-bg. */
+.now-screen {
+  --art-1: transparent;
+  --art-2: transparent;
+  transition: transform .32s cubic-bezier(.4,0,.2,1), visibility 0s linear .32s;
+}
+.now-screen::after {
+  content: ""; position: absolute; inset: 0; z-index: -1;
+  background: linear-gradient(175deg, var(--art-1) 0%, var(--art-2) 55%, transparent 90%);
+  opacity: 0; transition: opacity .7s ease, background .7s ease;
+  pointer-events: none;
+}
+.now-screen.tinted::after { opacity: 1; }
+/* Keep the vinyl glow in sympathy with the extracted colour */
+.now-screen.tinted .now-vinyl { box-shadow: 0 16px 56px var(--art-1); }
+
+/* The mini-player picks up a subtle edge of the same colour */
+.mini-player { --art-1: transparent; }
+.mini-player.tinted {
+  border-color: var(--art-1);
+  box-shadow: var(--shadow-lg), 0 0 0 1px var(--art-1);
+}
+
+/* ── Mini-player swipe ───────────────────────────────────────────
+   Horizontal drag skips tracks, upward drag expands. The bar follows
+   the finger, then snaps or animates out. */
+.mini-player.swiping { transition: none; }
+.mini-player.settling { transition: transform .26s var(--ease-soft), opacity .26s var(--ease-soft); }
+.mini-swipe-hint {
+  position: absolute; top: 50%; transform: translateY(-50%);
+  font-size: 22px; opacity: 0; pointer-events: none;
+  transition: opacity .12s; color: var(--purple);
+}
+.mini-swipe-hint.left  { left: 14px; }
+.mini-swipe-hint.right { right: 14px; }
+.mini-player.hint-next .mini-swipe-hint.left  { opacity: .9; }
+.mini-player.hint-prev .mini-swipe-hint.right { opacity: .9; }
+
+/* ── Playlist drag-to-reorder ────────────────────────────────────
+   Mirrors the queue's affordance so the two screens behave alike. */
+.pl-row.dragging { opacity: .4; }
+.pl-row.drag-over { background: var(--purple-bg); box-shadow: inset 0 2px 0 var(--purple); }
+.pl-grip {
+  color: var(--gray-400); font-size: 18px; cursor: grab;
+  padding: 0 2px; flex-shrink: 0; touch-action: none;
+}
+.reorder-hint {
+  padding: 0 18px 10px; font-size: 11px; color: var(--gray-400);
+  display: flex; align-items: center; gap: 5px;
+}
+
+/* ═══════════════════════════════════════════════════════════════
+   v25 — folders, card layout hardening, drag-to-file
+═══════════════════════════════════════════════════════════════ */
+
+/* Grid items must be allowed to shrink below their content width, or a
+   long album title can blow the column out and clip the right card. */
+.pl-grid, .folder-grid { min-width: 0; }
+.pl-card, .folder-card { min-width: 0; }
+.pl-card-name, .pl-card-count,
+.folder-name, .folder-count { min-width: 0; max-width: 100%; }
+/* Belt and braces: the page itself never scrolls sideways */
+.page { overflow-x: hidden; }
+
+/* Overflow menu moves to the top-right — where every other app puts it —
+   and the pin badge moves to the top-left so the two never collide. */
+.pl-card-menu { top: 14px; right: 14px; left: auto; }
+.pl-card .pin-badge { top: 18px; left: 18px; right: auto; }
+
+/* Library hero row with its own settings entry point */
+.lib-hero-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
+.lib-hero-set { color: #fff; }
+.lib-hero-set:active { background: rgba(255,255,255,.18); }
+
+/* ── Folders ─────────────────────────────────────────────────────
+   A folder is a shelf for albums/playlists — one level deep only, on
+   purpose: deep trees are where personal libraries go to die. */
+.folder-grid {
+  display: grid; grid-template-columns: 1fr 1fr;
+  gap: 12px; padding: 0 18px; margin-bottom: 16px;
+}
+.folder-grid:empty { display: none; }
+.folder-card {
+  position: relative; display: flex; align-items: center; gap: 10px;
+  background: var(--gray-50); border: 1.5px solid var(--gray-100);
+  border-radius: var(--r-sm); padding: 12px; cursor: pointer;
+  transition: transform .14s, box-shadow .14s, border-color .14s, background .14s;
+}
+.folder-card:active { transform: scale(.97); }
+.folder-cover {
+  width: 52px; height: 52px; border-radius: 11px; flex-shrink: 0;
+  overflow: hidden; box-shadow: var(--shadow-sm);
+  background: var(--gray-100);
+}
+.folder-cover.single img { width: 100%; height: 100%; object-fit: cover; }
+.folder-cover.quad {
+  display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr;
+  gap: 1px;
+}
+.folder-cover.quad img { width: 100%; height: 100%; object-fit: cover; }
+.folder-cover.empty {
+  background: var(--grad-brand); color: #fff;
+  display: flex; align-items: center; justify-content: center; font-size: 22px;
+}
+.folder-meta { min-width: 0; flex: 1; }
+.folder-name {
+  font-size: 13px; font-weight: 700; color: var(--black);
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+}
+.folder-count { font-size: 11px; color: var(--gray-400); margin-top: 2px; }
+
+/* Drop target feedback while dragging an album over a folder */
+.folder-card.drop-hot {
+  border-color: var(--purple); background: var(--purple-bg);
+  transform: scale(1.03);
+  box-shadow: 0 6px 20px rgba(74,26,107,.25);
+}
+.pl-card.dragging-card { opacity: .45; transform: scale(.95); }
+
+/* Ghost that follows the finger while dragging an album to a folder */
+.drag-ghost {
+  position: fixed; z-index: 900; pointer-events: none;
+  width: 96px; border-radius: 12px; overflow: hidden;
+  box-shadow: 0 12px 32px rgba(0,0,0,.35);
+  opacity: .92; transform: translate(-50%, -50%) rotate(-3deg);
+}
+.drag-ghost img, .drag-ghost .ph {
+  width: 96px; height: 96px; object-fit: cover; display: block;
+  background: var(--grad-brand);
+}
+
+/* Breadcrumb when inside a folder */
+.crumb {
+  display: flex; align-items: center; gap: 8px;
+  margin: 0 18px 14px; padding: 9px 12px;
+  background: var(--purple-bg); border-radius: var(--r-sm);
+}
+.crumb-back, .crumb-menu {
+  border: none; background: none; cursor: pointer;
+  color: var(--purple); font-size: 18px; padding: 2px;
+  display: flex; align-items: center;
+}
+.crumb-icon { color: var(--purple); font-size: 16px; display: flex; }
+.crumb-name {
+  flex: 1; min-width: 0; font-size: 14px; font-weight: 700; color: var(--purple);
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+}
+
+/* Long-press affordance hint under the playlists header */
+.lib-tip {
+  padding: 0 18px 12px; font-size: 11px; color: var(--gray-400);
+  display: flex; align-items: center; gap: 5px; line-height: 1.5;
+}
+
+/* Install / playback state box in About */
+.install-box { border-radius: 12px; padding: 12px 14px; }
+.install-box.ok {
+  background: var(--teal-bg); border: 1px solid rgba(8,145,178,.25);
+}
+.install-box.warn {
+  background: var(--gold-bg); border: 1px solid rgba(245,158,11,.35);
+}
+.install-h {
+  display: flex; align-items: center; gap: 7px;
+  font-size: 13px; font-weight: 700; margin-bottom: 6px; color: var(--black);
+}
+.install-box.ok  .install-h i { color: var(--teal); font-size: 17px; }
+.install-box.warn .install-h i { color: #B45309; font-size: 17px; }
+.install-box .about-p, .install-box .about-list li { font-size: 12.5px; }
+
+/* Measured diagnostics list in About */
+.check-list { list-style: none; margin: 8px 0; padding: 0; }
+.check-list li {
+  display: flex; align-items: flex-start; gap: 7px;
+  font-size: 12px; line-height: 1.5; padding: 3px 0; color: var(--gray-800);
+}
+.check-list li i { font-size: 15px; flex-shrink: 0; margin-top: 1px; }
+.check-list li.ok i { color: var(--teal); }
+.check-list li.no i { color: var(--rose); }
+.check-list li.warn { font-weight: 600; }
+.check-list li.warn i { color: #B45309; }
+
+/* The concrete fix, called out so it can't be missed */
+.fix-box {
+  margin-top: 12px; padding: 12px;
+  background: var(--white); border: 1.5px solid var(--purple);
+  border-radius: 12px;
+}
+.fix-h {
+  display: flex; align-items: center; gap: 7px;
+  font-size: 13px; font-weight: 700; color: var(--purple); margin-bottom: 6px;
+}
+.fix-code {
+  background: var(--gray-100); border-radius: 8px;
+  padding: 10px 12px; margin: 8px 0;
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 12px; line-height: 1.6; color: var(--black);
+  white-space: pre-wrap; word-break: break-word;
+}
+
+/* The ⋮ on every song row — deleting shouldn't need a hidden gesture */
+.t-menu {
+  position: relative;
+  border: none; background: none; cursor: pointer; padding: 4px;
+  color: var(--gray-400); font-size: 17px; flex-shrink: 0;
+  display: flex; align-items: center; justify-content: center;
+  border-radius: 50%; width: 30px; height: 30px;
+}
+/* Invisible 44px hit area — the control stays visually light but is
+   comfortably tappable, which matters most for the destructive actions. */
+.t-menu::after {
+  content: ""; position: absolute; top: 50%; left: 50%;
+  width: 44px; height: 44px; transform: translate(-50%, -50%);
+}
+.t-menu:active { background: var(--gray-100); color: var(--purple); }
+.t-right { display: flex; align-items: center; gap: 2px; }
+.pl-row .t-right { gap: 4px; }
+@media (hover: hover) and (pointer: fine) {
+  .t-menu:hover { color: var(--purple); background: var(--gray-100); }
+}
+
+/* ═══════════════════════════════════════════════════════════════
+   v28 — resume + recent searches
+═══════════════════════════════════════════════════════════════ */
+
+/* Resume strip: the fastest possible path back into your listening */
+.resume-strip {
+  display: flex; align-items: center; gap: 10px; width: calc(100% - 36px);
+  margin: 12px 18px 4px; padding: 12px 14px;
+  background: var(--purple-bg); border: 1px solid var(--gray-100);
+  border-radius: var(--r-sm); cursor: pointer; text-align: left;
+  color: var(--purple); font-size: 13px; font-weight: 600;
+}
+.resume-strip i:first-child { font-size: 18px; }
+.resume-strip span { flex: 1; min-width: 0; overflow: hidden;
+  text-overflow: ellipsis; white-space: nowrap; }
+.resume-strip:active { transform: scale(.99); }
+
+/* Recent searches */
+.recent-box { padding: 0 18px 8px; }
+.recent-h {
+  display: flex; align-items: center; justify-content: space-between;
+  font-size: 11px; font-weight: 700; color: var(--gray-400);
+  text-transform: uppercase; letter-spacing: .5px; margin-bottom: 8px;
+}
+.recent-clear {
+  border: none; background: none; color: var(--purple);
+  font-size: 11px; font-weight: 700; cursor: pointer; padding: 2px 4px;
+}
+.recent-chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.recent-chip {
+  display: inline-flex; align-items: center; gap: 5px;
+  border: 1px solid var(--gray-200); background: var(--white);
+  border-radius: 16px; padding: 6px 11px;
+  font-size: 12px; color: var(--gray-800); cursor: pointer;
+  max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
+}
+.recent-chip i { font-size: 13px; color: var(--gray-400); }
+.recent-chip:active { background: var(--purple-bg); border-color: var(--purple); }
+
+/* ═══════════════════════════════════════════════════════════════
+   v29 — stacking order, stated once so it stops drifting
+
+   The full player is the topmost *surface* in any music app: opening it
+   should cover whatever sheet you came from. Previously .now-screen sat
+   at 450, below .sheet at 500 — so playing an episode from a show sheet
+   and then tapping the mini-player showed you the sheet again, with the
+   player stranded underneath.
+
+   pages 1 · mini-player 400 · sheets 500 · NOW-SCREEN 600
+   · action menus 800 · pickers 820 · text modals 840 · toast 900
+═══════════════════════════════════════════════════════════════ */
+.now-screen  { z-index: 600; }
+.modal-back  { z-index: 800; }
+#add-pl-sheet, #folder-pick-sheet { z-index: 820; }
+#create-pl-modal, #folder-name-modal { z-index: 840; }
+.bulk-bar    { z-index: 700; }
+.toast       { z-index: 900; }
+
+/* ── Back-to-top button ───────────────────────────────────────────────
+   Appears once you've scrolled a page down a screenful or more. Sits just
+   above the mini-player so it never covers playback controls. */
+.to-top {
+  position: fixed;
+  right: 16px;
+  bottom: calc(var(--player-h, 64px) + var(--nav-h, 62px) + 14px);
+  width: 44px; height: 44px; border-radius: 50%;
+  background: var(--grad-brand); color: #fff; border: none;
+  box-shadow: var(--shadow-lg);
+  display: flex; align-items: center; justify-content: center;
+  font-size: 20px; cursor: pointer; z-index: 60;
+  opacity: 0; transform: translateY(12px) scale(.9);
+  pointer-events: none;
+  transition: opacity .2s, transform .2s;
+}
+.to-top.show { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
+.to-top:active { transform: scale(.92); }
