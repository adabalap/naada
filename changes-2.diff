+  function clear() {
+    clearTimeout(timer); timer = null;
+    if (row) row.classList.remove("pressing");
+    row = null;
+  }
+
+  document.addEventListener("pointerdown", e => {
+    const r = e.target.closest(".track[data-id], .mini-card[data-id]");
+    if (!r) return;
