+S.playCounts = LS.get("nd_playcounts", {});
+
+function bumpPlayCount(t) {
+  if (!t?.id) return;
+  const e = S.playCounts[t.id] || { n: 0, t };
+  e.n += 1; e.t = { id:t.id, title:t.title, artist:t.artist, image:t.image, duration:t.duration };
