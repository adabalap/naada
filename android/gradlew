#!/bin/sh
#
# Gradle wrapper script — do not edit.  Generated by 'gradle wrapper'.
# This is checked into git so the build runs on any machine (including
# GitHub Actions runners) without Gradle pre-installed.
#

# Resolve the application directory (handles symlinks on macOS/Linux)
APP_HOME="$(cd "$(dirname "$0")" && pwd -P)" || exit
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

# Determine JAVA_HOME
if [ -n "$JAVA_HOME" ]; then
  if [ -x "$JAVA_HOME/jre/sh/java" ]; then JAVACMD="$JAVA_HOME/jre/sh/java"
  else JAVACMD="$JAVA_HOME/bin/java"; fi
  if [ ! -x "$JAVACMD" ]; then
    die "ERROR: JAVA_HOME='$JAVA_HOME', but java not found"
  fi
else
  JAVACMD="java"; command -v java >/dev/null 2>&1 ||
    die "ERROR: JAVA_HOME is not set and 'java' is not in PATH"
fi

exec "$JAVACMD" \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain \
  "$@"
