<resources>
    <style name="Theme.Naada" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/naada_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Naada.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/naada_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Naada</item>
    </style>
</resources>
